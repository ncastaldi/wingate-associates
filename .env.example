# Environment for the compose stack. Paste this whole file into the Komodo
# stack's Environment and fill in the blanks; every line here is read by
# compose.yaml. For local development, copy it to .env instead (see the last
# section). Never commit real values.
#
# Komodo's deploy log prints these values (Compose Config stage). Redact it
# before sharing.

# Database. compose.yaml builds DATABASE_URL for web and migrate from these,
# so do not set DATABASE_URL here. Postgres reads the password only when it
# first creates its volume; changing it later needs ALTER USER or a new volume.
# Letters and digits only, because it goes unencoded into a URL:
#   openssl rand -hex 24
POSTGRES_USER=wingate
POSTGRES_PASSWORD=
POSTGRES_DB=wingate

# Cloudflare Tunnel token (remote-managed tunnel). Zero Trust dashboard ->
# Networks -> Tunnels -> your tunnel -> Overview. The public hostname
# (https://wingate.associates -> http://web:3000) is configured there, not here.
# The token is a long base64 string (it starts with "eyJ"). The tunnel ID, a
# UUID, is not a token, and cloudflared will fail to start with it.
CLOUDFLARE_TUNNEL_TOKEN=

# Resend, the one approved hosted service (ADR-003). The sender must use a
# domain verified in Resend. No quotes needed:
#   CONTACT_TO_EMAIL=hello@wingate.associates       (plain address only)
#   CONTACT_FROM_EMAIL=Wingate Associates <hello@wingate.associates>
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Plausible analytics (ADR-005). Full URL of your instance's per-site script,
# e.g. https://plausible.example.com/js/pa-XXXX.js. Inlined at build time, so
# a change needs a rebuild. Leave empty to disable analytics.
NEXT_PUBLIC_PLAUSIBLE_SRC=

# Self-hosted booking, Cal.diy (ADR-006). These are required: a blank value stops
# the deploy on purpose, so Cal.diy never starts with an empty secret.
# Public hostname, no scheme. Add it as a published application on the tunnel
# (https://<CAL_HOST> -> http://cal:3000). It must be under the site's domain
# so the Cloudflare edge rules apply (see deploy/README.md).
CAL_HOST=cal.wingate.associates
# Letters and digits only, because it goes unencoded into a URL:
#   openssl rand -hex 24
CAL_DB_PASSWORD=
#   openssl rand -base64 32
CAL_NEXTAUTH_SECRET=
# Encrypts stored calendar credentials. Losing it makes connected calendars
# unreadable, so keep a copy in the owner's password manager:
#   openssl rand -hex 16
CAL_ENCRYPTION_KEY=
# Pinned release. Check the changelog before raising it.
CAL_VERSION=v6.2.0
# Sender for booking emails. Must use the domain verified in Resend.
CAL_EMAIL_FROM=notifications@wingate.associates
# Booking page embedded on /contact, e.g. https://cal.wingate.associates/<user>/<event>.
# Leave empty until the first event type exists; the page then shows a note
# instead of the embed. Must start with https://.
BOOKING_URL=

# Local development only: npm run dev and npm run db:migrate need a direct
# connection string to a Postgres you run locally. Uncomment it in your .env.
# Not used by compose.yaml; leave it out of Komodo.
# DATABASE_URL=postgres://wingate:<password>@localhost:5432/wingate
