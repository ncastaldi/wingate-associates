# Copy to .env for local development. Never commit real values.
# In production these are Komodo variables.

# Local database (matches compose.yaml)
POSTGRES_USER=wingate
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wingate
DATABASE_URL=postgres://wingate:change-me@localhost:5432/wingate

# Cloudflare Tunnel token (remote-managed tunnel). Zero Trust dashboard ->
# Networks -> Tunnels -> your tunnel -> Overview. The public hostname
# (https://wingate.associates -> http://web:3000) is configured there, not here.
# The token is a long base64 string (it starts with "eyJ"). The tunnel ID, a
# UUID, is not a token, and cloudflared will fail to start with it.
CLOUDFLARE_TUNNEL_TOKEN=

# Resend, the one approved hosted service (ADR-003)
# CONTACT_TO_EMAIL must be a plain address; CONTACT_FROM_EMAIL may be "Name <addr>"
# and must use a domain verified in Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Plausible analytics (ADR-005). Full URL of your instance's per-site script,
# e.g. https://plausible.example.com/js/pa-XXXX.js. Inlined at build time.
# Leave empty to disable analytics.
NEXT_PUBLIC_PLAUSIBLE_SRC=
