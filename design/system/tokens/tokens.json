{
  "$description": "Wingate Associates design tokens. Mirrors the CSS custom properties in tokens/*.css. Colour values are per scheme.",
  "brand": {
    "wa-navy": "#0e2745",
    "wa-teal": "#296e7b",
    "wa-slate": "#75838e",
    "wa-paper": "#f6f6f2"
  },
  "color": {
    "bg": {
      "light": "#f6f6f2",
      "dark": "#0b1420"
    },
    "surface": {
      "light": "#ffffff",
      "dark": "#111c2a"
    },
    "surface-sunken": {
      "light": "#ecede7",
      "dark": "#08101a"
    },
    "grid-line": {
      "light": "rgba(14,39,69,.055)",
      "dark": "rgba(127,203,211,.05)"
    },
    "text": {
      "light": "#0e2745",
      "dark": "#e7ecf0"
    },
    "text-muted": {
      "light": "#4b5a6b",
      "dark": "#9cabb9"
    },
    "border": {
      "light": "#d6d9d6",
      "dark": "#22324a"
    },
    "border-strong": {
      "light": "#8a96a1",
      "dark": "#5a6b80"
    },
    "accent": {
      "light": "#296e7b",
      "dark": "#5db5bf"
    },
    "link": {
      "light": "#1f6470",
      "dark": "#7fcbd3"
    },
    "link-hover": {
      "light": "#0e2745",
      "dark": "#e7ecf0"
    },
    "focus": {
      "light": "#296e7b",
      "dark": "#7fcbd3"
    },
    "selection": {
      "light": "rgba(41,110,123,.2)",
      "dark": "rgba(127,203,211,.25)"
    },
    "primary": {
      "light": "#0e2745",
      "dark": "#5db5bf"
    },
    "primary-hover": {
      "light": "#1a3a5e",
      "dark": "#7fcbd3"
    },
    "primary-active": {
      "light": "#081a30",
      "dark": "#4a9aa3"
    },
    "on-primary": {
      "light": "#ffffff",
      "dark": "#0b1420"
    },
    "ok": {
      "light": "#1c7346",
      "dark": "#5cc995"
    },
    "warn": {
      "light": "#8f5300",
      "dark": "#e9b453"
    },
    "critical": {
      "light": "#b02a1e",
      "dark": "#ff8577"
    },
    "ok-dot": {
      "light": "#2a9a5f",
      "dark": "#4cc38a"
    },
    "warn-dot": {
      "light": "#b07400",
      "dark": "#e8ad3f"
    },
    "critical-dot": {
      "light": "#d23a2c",
      "dark": "#ff6b5e"
    },
    "ok-bg": {
      "light": "#e6f2ea",
      "dark": "#0f2419"
    },
    "ok-border": {
      "light": "#9ccbb0",
      "dark": "#2b5c40"
    },
    "warn-bg": {
      "light": "#fbf1dc",
      "dark": "#241c0c"
    },
    "warn-border": {
      "light": "#e2c27a",
      "dark": "#6b5320"
    },
    "critical-bg": {
      "light": "#fbe9e6",
      "dark": "#2a1312"
    },
    "critical-border": {
      "light": "#e7a39b",
      "dark": "#7a3830"
    }
  },
  "typography": {
    "font-sans": "\"Instrument Sans\",system-ui,-apple-system,\"Segoe UI\",sans-serif",
    "font-mono": "\"IBM Plex Mono\",ui-monospace,\"SF Mono\",Menlo,Consolas,monospace",
    "text-display": "clamp(2.5rem,1.6rem + 3.9vw,4.5rem)",
    "text-h1": "clamp(2.25rem,1.8rem + 2vw,3.5rem)",
    "text-h2": "clamp(1.5rem,1.35rem + .7vw,2rem)",
    "text-h3": "1.1875rem",
    "text-lead": "clamp(1.1875rem,1.1rem + .4vw,1.375rem)",
    "text-body": "1.0625rem",
    "text-small": ".875rem",
    "text-mono": ".8125rem",
    "leading-display": "1.02",
    "leading-heading": "1.12",
    "leading-h3": "1.3",
    "leading-body": "1.6",
    "leading-small": "1.5",
    "tracking-display": "-.035em",
    "tracking-heading": "-.022em",
    "tracking-h3": "-.01em",
    "tracking-mono": ".06em",
    "weight-regular": "400",
    "weight-medium": "500",
    "weight-semibold": "600",
    "measure": "38rem",
    "measure-narrow": "30rem",
    "measure-display": "14ch"
  },
  "spacing": {
    "space-1": ".25rem",
    "space-2": ".5rem",
    "space-3": ".75rem",
    "space-4": "1rem",
    "space-5": "1.5rem",
    "space-6": "2rem",
    "space-7": "3rem",
    "space-8": "4rem",
    "space-9": "6rem",
    "space-10": "8rem",
    "page-max": "72rem",
    "gutter": "clamp(1.25rem,4vw,2.5rem)",
    "grid-columns": "12",
    "grid-gap": "clamp(1rem,2.5vw,2rem)",
    "section-gap": "clamp(4rem,3rem + 4vw,7rem)",
    "header-height": "4rem"
  },
  "effects": {
    "rule": "1px",
    "rule-strong": "1.5px",
    "radius-sm": "2px",
    "radius": "4px",
    "radius-dot": "50%",
    "shadow-none": "none",
    "shadow-raised": "0 1px 2px rgba(14,39,69,.06),0 10px 24px -14px rgba(14,39,69,.22)",
    "focus-width": "2px",
    "focus-offset": "3px",
    "grid-size": "32px",
    "grid-pattern": "linear-gradient(to right,var(--grid-line) 1px,transparent 1px),linear-gradient(to bottom,var(--grid-line) 1px,transparent 1px)",
    "dot-size": ".5rem",
    "ease": "cubic-bezier(.2,0,0,1)",
    "dur-fast": "120ms",
    "dur": "200ms",
    "dur-slow": "480ms"
  },
  "effectsDark": {
    "shadow-raised": "0 0 0 1px var(--border-strong)"
  },
  "reducedMotion": {
    "dur-fast": "0ms",
    "dur": "0ms",
    "dur-slow": "0ms"
  },
  "breakpoints": {
    "sm": "30em",
    "md": "48em",
    "lg": "64em"
  },
  "alternatePalette_green": {
    "$note": "Palette B, kept for comparison only. Not recommended: the accent collides with the ok status colour.",
    "light": {
      "bg": "#f5f6f3",
      "text": "#15191d",
      "text-muted": "#535b63",
      "accent": "#1b7a4b",
      "primary": "#176b41"
    },
    "dark": {
      "bg": "#0d1110",
      "text": "#e6eae7",
      "accent": "#4fc487",
      "primary": "#4fc487"
    }
  }
}